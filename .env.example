# Copy to .env and fill in. Never commit .env.
# See src/config.py for how each value is used.

# --- Scraping ---
# Comma-separated Finn.no keywords (also used for NAV sources)
FINN_KEYWORDS=seafood,aquaculture,sjømat
# Daily pipeline trigger (UTC, HH:MM)
RUN_TIME=09:30

# --- Snov.io (enrichment) ---
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
# Auto-created if empty
SNOV_LIST_ID=

# --- Outreach (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=fredrik.hansen@sperton.com
FROM_NAME=Fredrik Hansen
# Daily send-job trigger (UTC, HH:MM)
SEND_TIME=08:30
# Follow-up sequences: false (default) = follow-ups are created as drafts
# awaiting human approval; true = create pre-approved AND send immediately.
FOLLOWUP_AUTO_SEND=false
FOLLOWUP_MIN_DAYS=3
FOLLOWUP_MAX_STEP=3

# --- AI personalization (optional, falls back to templates) ---
ANTHROPIC_API_KEY=

# --- Web dashboard ---
# Required in production. If unset, an ephemeral random secret is used
# (sessions won't survive restarts) and a warning is logged.
FLASK_SECRET=
LOG_LEVEL=INFO
