# Copy to .env and fill in. Never commit .env.
# See src/config.py for how each value is used.

# --- Scraping ---
# Comma-separated Finn.no keywords (also used for NAV sources)
FINN_KEYWORDS=seafood,aquaculture,sjømat
# Daily pipeline trigger (UTC, HH:MM)
RUN_TIME=09:30
# Parallel posting workers (each runs its own browser; capped at 4)
PIPELINE_WORKERS=2
# Max seconds spent per company domain (website + enrichment)
DOMAIN_TIMEOUT_SEC=300
# Cap on company domains revisited per run by the careers source
CAREERS_MAX_DOMAINS=30
# Posting revalidation per run (keeps campaigns tied to live ads)
REVALIDATE_LIMIT=50
REVALIDATE_MAX_AGE_DAYS=7
REVALIDATE_BUDGET_SEC=300

# --- Snov.io (enrichment) ---
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
# Auto-created if empty
SNOV_LIST_ID=
# Abort a run when balance falls below this (0 = only abort when empty)
SNOV_MIN_CREDITS=0
# Warn (+ webhook if WEBHOOK_URL is set) when balance drops below this
SNOV_LOW_WATER_CREDITS=200

# --- Outreach (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=fredrik.hansen@sperton.com
FROM_NAME=Fredrik Hansen
# Daily send-job trigger (UTC, HH:MM)
SEND_TIME=08:30
# Follow-up sequences: false (default) = follow-ups are created as drafts
# awaiting human approval; true = create pre-approved AND send immediately.
FOLLOWUP_AUTO_SEND=false
FOLLOWUP_MIN_DAYS=3
FOLLOWUP_MAX_STEP=3

# --- AI personalization (optional, falls back to templates) ---
ANTHROPIC_API_KEY=

# --- Web dashboard ---
# Required in production. If unset, an ephemeral random secret is used
# (sessions won't survive restarts) and a warning is logged.
FLASK_SECRET=
LOG_LEVEL=INFO
# pretty (colored, human) or json (one JSON object per line, for aggregation)
LOG_FORMAT=pretty
# Dashboard login. Unset = open dashboard (bind 127.0.0.1 only).
DASHBOARD_USER=
DASHBOARD_PASS=

# --- Storage ---
# Override the SQLite file location (e.g. a mounted volume). Unset = ./leads.db
LEADS_DB_PATH=
